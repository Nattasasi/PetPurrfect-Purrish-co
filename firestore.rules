rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAdminProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total >= 0;

      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true
      );

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      // Anonymous creation goes through /api/messages, which enforces the same
      // field names/lengths, server time, idempotency, and request limits.
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /funnel_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /quiz_results/{resultId} {
      // Writes only happen server-side via the Admin SDK, which bypasses rules.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
