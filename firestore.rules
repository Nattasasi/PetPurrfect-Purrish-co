rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAdminProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (
          !('active' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        );
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total >= 0;

      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true
      );

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt'])
      );

      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'status', 'source', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 150
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'unread'
        && request.resource.data.source == 'contact-page'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

